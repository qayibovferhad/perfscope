# Configuration for `docker compose -f docker-compose.prod.yml up`.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker -f docker-compose.prod.yml up -d --build
#
# The flag is required — compose reads `${...}` from its own environment and from `.env`,
# never from a service's env_file.
#
# Only JWT_SECRET is required. Every optional key degrades the same way it does on a
# laptop: the feature turns off, nothing crashes.

# Signs the access tokens. Any long random string; changing it signs everyone out.
#   openssl rand -hex 32
JWT_SECRET=

# The address people open the dashboard at. It becomes the backend's CORS origin and the
# Socket.io handshake origin, so it has to be the public URL — not the container name, and
# not http://backend:3101. Include the port if there is one.
PUBLIC_URL=http://localhost:8080

# Host port the dashboard is published on.
WEB_PORT=8080

# Where the bundle looks for the API. Leave EMPTY for the normal setup, where the web
# container's nginx proxies to the backend on the same origin. Set it only if the backend
# is served from a different host — then that host needs its own CORS origin to match.
BACKEND_URL=

# Audits running at once. Each one owns a Chrome instance, and runs that compete for CPU
# report worse numbers than the page deserves, so this is a measurement knob rather than
# just a resource limit. At or below the container's core count.
MAX_CONCURRENT_AUDITS=2

# AI insights. Without it the audit still runs and the AI panels simply do not appear.
GEMINI_API_KEY=

# Google sign-in. The same value reaches both containers: the dashboard renders the button
# with it, the backend checks that a token was issued for this app. Email/password sign-in
# works without it.
GOOGLE_CLIENT_ID=

# Chrome UX Report — real-user field data beside the lab numbers. Hidden when unset.
CRUX_API_KEY=

# The container runs with NODE_ENV=production, which REFUSES to audit any URL that
# resolves into its own network — localhost, 10.x, 169.254.169.254 and the rest. That is
# the SSRF guard, and it is why a containerised install cannot audit http://localhost:8080.
# Set this to true for an install that deliberately audits an intranet.
ALLOW_PRIVATE_TARGETS=false

# ── Observability ────────────────────────────────────────────────────────────

# How much is logged and in what shape. The containers default to json/info — one JSON
# object per line, which is what a log collector can filter. `text` is the human format the
# server prints on a laptop; `debug` adds the /health checks and every socket connect.
LOG_FORMAT=json
LOG_LEVEL=info

# Error reporting. Without it, errors are logged and nothing is sent anywhere. With it,
# every `log.error` is also filed — tagged with the scope and the request id, so an issue
# and the surrounding log lines line up.
SENTRY_DSN=

# Backups. The mongo-backup service dumps the database into a named volume on this
# interval and keeps this many days. It is a LOCAL window — see docs/deploy/BACKUP.md for
# getting the archives off the host, which nothing here does for you.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Budget-breach emails. Recorded either way; delivered only with SMTP configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PerfScope Alerts <alerts@perfscope.local>
