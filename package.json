{
  "name": "perfscope",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@perfscope/backend",
    "dev:web": "turbo dev --filter=@perfscope/web-dashboard",
    "dev:ext": "turbo dev --filter=@perfscope/chrome-extension",
    "build": "turbo build",
    "build:web": "turbo build --filter=@perfscope/web-dashboard",
    "lint": "turbo lint",
    "test": "turbo test",
    "e2e": "node --test e2e/*.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "core-js",
      "esbuild",
      "protobufjs",
      "puppeteer",
      "spawn-sync"
    ]
  }
}
