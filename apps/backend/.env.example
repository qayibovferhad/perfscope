PORT=3101
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Rolling aliases only; measured with probes/model-tier.probe.mts before changing.
# GEMINI_MODEL=gemini-flash-lite-latest
NODE_ENV=development

# Email alerts (optional — budget breach emails are disabled when unset)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<app password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PerfScope Alerts <you@gmail.com>

# Google sign-in. Optional: without it Google sign-in still works, but the backend cannot
# check that a token was issued for *this* app. Use the same value as the dashboard's
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Chrome UX Report — real-user field data next to the Lighthouse lab numbers.
# Optional: field data is simply hidden when unset.
# Enable the "Chrome UX Report API" in a Google Cloud project, then create an
# API key at console.cloud.google.com/apis/credentials
CRUX_API_KEY=

# Private-network targets. With NODE_ENV=production the server refuses to audit, scan or
# POST to a URL that resolves into its own network (localhost, 10.x, 169.254.169.254 …),
# because every one of those is a server-side fetch someone else can aim. Development is
# unaffected — auditing http://localhost:5173 is the ordinary case there. Set this to true
# for an install that deliberately audits an intranet.
# ALLOW_PRIVATE_TARGETS=false
