PORT=3101
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development

# Email alerts (optional — budget breach emails are disabled when unset)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<app password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PerfScope Alerts <you@gmail.com>

# Chrome UX Report — real-user field data next to the Lighthouse lab numbers.
# Optional: field data is simply hidden when unset.
# Enable the "Chrome UX Report API" in a Google Cloud project, then create an
# API key at console.cloud.google.com/apis/credentials
CRUX_API_KEY=
